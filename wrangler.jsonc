{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "germanlearn",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      "tests/**",
      "server.py",
      "package.json",
      "package-lock.json",
      ".git/**"
    ]
  }
}
